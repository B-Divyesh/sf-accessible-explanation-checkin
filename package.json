{
  "name": "accessible-explanation-checkin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --config frontend/vite.config.ts\" \"cargo run\"",
    "build": "vite build --config frontend/vite.config.ts",
    "deploy": "bash scripts/deploy-durable-container.sh",
    "test": "tsc --noEmit -p frontend/tsconfig.json && vitest run --config frontend/vite.config.ts && cargo test && bash scripts/test-deploy-container-name.sh && bash scripts/test-durable-deploy.sh && bash scripts/test-live-durable-workflow.sh && bash scripts/test-product-candidate.sh && bash scripts/test-live-topology.sh",
    "test:deploy-helper": "bash scripts/test-deploy-container-name.sh",
    "test:container-identity": "bash scripts/test-container-build-identity.sh",
    "test:runtime-policy": "bash scripts/test-nonroot-runtime.sh",
    "test:deployment-policy": "bash scripts/test-durable-deploy.sh",
    "test:live-durability-checker": "bash scripts/test-live-durable-workflow.sh",
    "test:live-topology": "bash scripts/test-product-candidate.sh && bash scripts/test-live-topology.sh",
    "verify:live-topology": "bash scripts/verify-live-topology.sh https://accessible-explanation-checkin.sociobot.in sf-accessible-explanation-9c1a54 sociobot $(bash scripts/resolve-product-candidate.sh) aec-accessible-explanati-9c1a54 sf-accessible-explanation-checkin-data",
    "test:e2e": "npm run test:e2e:desktop && npm run test:e2e:mobile",
    "test:e2e:desktop": "npm run test:e2e:desktop:app && npm run test:e2e:desktop:claims-a && npm run test:e2e:desktop:claims-b",
    "test:e2e:mobile": "npm run test:e2e:mobile:app && npm run test:e2e:mobile:claims-a && npm run test:e2e:mobile:claims-b",
    "test:e2e:desktop:app": "playwright test --config frontend/playwright.config.ts frontend/tests/app.spec.ts --project=desktop-chromium",
    "test:e2e:desktop:claims-a": "playwright test --config frontend/playwright.config.ts frontend/tests/claims.spec.ts --project=desktop-chromium --grep '@claim:(demo-isolation|demo-reset|demo-exit-disposal|sample-csv-export|keyboard-demo|offline-demo|student-draft-local|no-account-needed|stored-record-shape|recent-links-local|prompt-character-limit)'",
    "test:e2e:desktop:claims-b": "playwright test --config frontend/playwright.config.ts frontend/tests/claims.spec.ts --project=desktop-chromium --grep '@claim:(voice-retention-control|voice-recording-limits|voice-retention-deletion|teacher-voice-deletion|free-response-limit|no-automated-judgment|student-keyboard-flow|student-review-workflow|privacy-request-boundary|classroom-plus-limits|billing-license-fixture|refund-license-contract|external-checkout|runtime-container-policy|durable-deployment-policy)'",
    "test:e2e:mobile:app": "playwright test --config frontend/playwright.config.ts frontend/tests/app.spec.ts --project=mobile-chromium",
    "test:e2e:mobile:claims-a": "playwright test --config frontend/playwright.config.ts frontend/tests/claims.spec.ts --project=mobile-chromium --grep '@claim:(demo-isolation|demo-reset|demo-exit-disposal|sample-csv-export|keyboard-demo|offline-demo|student-draft-local|no-account-needed|stored-record-shape|recent-links-local|prompt-character-limit)'",
    "test:e2e:mobile:claims-b": "playwright test --config frontend/playwright.config.ts frontend/tests/claims.spec.ts --project=mobile-chromium --grep '@claim:(voice-retention-control|voice-recording-limits|voice-retention-deletion|teacher-voice-deletion|free-response-limit|no-automated-judgment|student-keyboard-flow|student-review-workflow|privacy-request-boundary|classroom-plus-limits|billing-license-fixture|refund-license-contract|external-checkout|runtime-container-policy|durable-deployment-policy)'",
    "test:claims": "playwright test --config frontend/playwright.config.ts frontend/tests/claims.spec.ts",
    "test:all-claims": "node scripts/test-all-claims.mjs",
    "audit:live": "node .factory/live-audit.mjs",
    "preview": "vite preview --config frontend/vite.config.ts --host 0.0.0.0",
    "start": "cargo run --release"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.58.2",
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
